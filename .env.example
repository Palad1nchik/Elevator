# Скопируйте в .env и поправьте под себя:  cp .env.example .env
# Используется только локальным docker compose; на Render переменные
# задаются в render.yaml / панели Render.

# Порт, на котором сайт открывается на этой машине: http://localhost:<WEB_PORT>
WEB_PORT=8080

# Режим бэкенда: development | production
APP_ENV=production
