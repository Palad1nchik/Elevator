# Runtime environment: development | production
APP_ENV=development

# Bind address
HOST=0.0.0.0
PORT=8080

# Comma-separated list of browser origins allowed via CORS. Only relevant when
# the frontend is served from a different origin (Vite dev server on :5173).
# In the production Docker image the site and the API share one origin, so
# CORS is not involved at all.
CORS_ORIGINS=http://localhost:5173

# If set, the server also serves the built frontend (SPA) from this directory
# with an index.html fallback. Empty = API-only mode (local development).
# The production Docker image sets STATIC_DIR=/app/public.
STATIC_DIR=
